# Copy this file to .env. Never commit .env, uploaded spreadsheets, the database, or runtime AI keys.
# Optional general access lock. Leave blank for direct local access.
ACCESS_TOKEN=
# Required only for changing LLM settings from the admin screen.
ADMIN_PASSWORD=
PORT=8766
BIND_HOST=127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1,::1,testserver,host.docker.internal

# excel: official numbering is owned by the Excel catalog; new drafts cannot issue codes.
# system: the app becomes the official catalog and permits explicit approval/numbering.
CATALOG_AUTHORITY=excel

# Empty means NO automatic numbering. Manual approved codes are possible in system mode.
# Example only; configure your actual approved rule before enabling:
# CODE_RULES_JSON={"AT":{"start":2000,"width":4}}
CODE_RULES_JSON={}

# Optional model endpoint. Disabled means no document/query/model traffic is sent out.
AI_ENABLED=false
AI_BASE_URL=http://host.docker.internal:1234/v1
AI_API_KEY=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=
# Explicit consent required for a non-local HTTPS endpoint.
AI_ALLOW_EXTERNAL=false

# Command Code alternative: requires installed CLI + existing login on this host.
AI_PROVIDER=openai-compatible
COMMAND_CODE_BIN=cmd
# Claude Code CLI transport (npm: @anthropic-ai/claude-code).
CLAUDE_CODE_BIN=claude
AI_REASONING_EFFORT=low
AI_TIMEOUT_SECONDS=90
